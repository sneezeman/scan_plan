BootStrap: docker
From: mirror.gcr.io/library/ubuntu:24.04

%environment
    # Qt/VTK rendering via X11 (NICE/NoMachine on the cluster)
    export QT_QPA_PLATFORM=xcb
    export PYVISTA_OFF_SCREEN=false
    # Disable the D-Bus session bus — scan_plan doesn't need it and the
    # container may not have a valid /etc/machine-id at runtime once
    # Apptainer bind-mounts the host's. Without this, PyQt5/QtDBus
    # crashes at startup with "No machine-id" / dbus connection errors.
    export DBUS_SESSION_BUS_ADDRESS=disabled:

%files

%post
    ### General packages
    export DEBIAN_FRONTEND=noninteractive
    apt-get -y update
    apt-get -y full-upgrade
    apt-get -y install --no-install-recommends ca-certificates
    apt-get -y install --no-install-recommends python3 python3-pip python-is-python3 git \
        libgl1 \
        libegl1 \
        libgles2 \
        libglx-mesa0 \
        libxrender1 \
        libxkbcommon-x11-0 \
        libxcb-xinerama0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-cursor0 \
        libxcb-xfixes0 \
        libfontconfig1 \
        libdbus-1-3 \
        libglib2.0-0 \
        libx11-xcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxi6 \
        libxtst6 \
        libxrandr2 \
        libxcursor1 \


    mkdir sources && cd sources

    # The source is fetched with GitLab's ephemeral CI_JOB_TOKEN, which is only
    # valid while the build job runs. NEVER inline a long-lived deploy token
    # here: this file lives in a public repository.
    #
    # The token is injected by the ESRF CI template, which turns every name in
    # APPTAINER_TEMPLATE_VARIABLES into a build arg. Two prerequisites:
    #   1. .gitlab-ci.yml sets  APPTAINER_TEMPLATE_VARIABLES: "CI_JOB_TOKEN"
    #   2. artem1706/scan_plan lists apptainer/scan_planner under
    #      Settings -> CI/CD -> Job token permissions (else the clone 403s)
    #
    # NOTE: do not write the build-var braces anywhere else in this file (not
    # even inside a comment or an echo) - Apptainer parses every occurrence and
    # fails the build if the variable is not supplied.

    # set +x so the credentialed URL never reaches the CI job log.
    set +x
    git clone --depth 1 \
        "https://gitlab-ci-token:{{ CI_JOB_TOKEN }}@gitlab.esrf.fr/artem1706/scan_plan.git" \
        scan_plan.git \
        || { echo "ERROR: clone failed - check the job-token allowlist" >&2; exit 1; }

    pip install --break-system-packages ./scan_plan.git

    # Drop the checkout: .git/config stores the credentialed remote URL, which
    # would otherwise be baked into the image published on CVMFS.
    cd /
    rm -rf /sources

    apt remove --purge -y git
    apt autoremove -y --purge
    apt autoclean -y

    cat /proc/sys/kernel/random/uuid | tr -d '-' > /etc/machine-id
    mkdir -p /var/lib/dbus
    cp /etc/machine-id /var/lib/dbus/machine-id

%runscript
    exec scan_planner $@

%labels
    Author William Chevremont (william.chevremont@esrf.fr), Artem Vorobyev (artem.vorobyev@esrf.fr)
