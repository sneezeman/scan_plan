Bootstrap: docker
From: ubuntu:24.04

%labels
    Author Artem (ID16A, ESRF)
    Description scan_planner - Cylinder Packing Strategy GUI for high-resolution tomography
    Version 5.1.0

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get -y update

    # System libraries needed by Qt5, VTK/Mesa, and X11
    apt-get -y install --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
        python-is-python3 \
        libgl1 \
        libegl1 \
        libgles2 \
        libglx-mesa0 \
        libxrender1 \
        libxkbcommon-x11-0 \
        libxcb-xinerama0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-cursor0 \
        libxcb-xfixes0 \
        libfontconfig1 \
        libdbus-1-3 \
        libglib2.0-0 \
        libx11-xcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxi6 \
        libxtst6 \
        libxrandr2 \
        libxcursor1

    # Install Python dependencies system-wide
    # --break-system-packages is needed on Ubuntu 24.04 (PEP 668)
    pip install --no-cache-dir --break-system-packages \
        numpy \
        tifffile \
        pyvista \
        pyvistaqt \
        pandas \
        "scipy>=1.15" \
        PyQt5 \
        pint \
        pytest

    apt-get clean && rm -rf /var/lib/apt/lists/*

    # D-Bus needs a machine-id; generate one at build time
    cat /proc/sys/kernel/random/uuid | tr -d '-' > /etc/machine-id
    mkdir -p /var/lib/dbus
    cp /etc/machine-id /var/lib/dbus/machine-id

%environment
    # Qt/VTK rendering via X11 (NICE/NoMachine on the cluster)
    export QT_QPA_PLATFORM=xcb
    export PYVISTA_OFF_SCREEN=false
    # Disable D-Bus session bus — scan_planner doesn't need it and the
    # container may not have a valid machine-id at runtime
    export DBUS_SESSION_BUS_ADDRESS=disabled:

%runscript
    exec scan_planner "$@"

%test
    python -c "import numpy; import scipy; import pyvista; import PyQt5; print('All imports OK')"
    python -c "from scipy.spatial.transform import RigidTransform; print('RigidTransform available')"
    python -c "import scipy; assert tuple(int(x) for x in scipy.__version__.split('.')[:2]) >= (1,15), 'scipy too old'"
