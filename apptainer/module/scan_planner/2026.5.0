#%Module1.0
##
## scan_planner - Cylinder Packing Strategy GUI for high-resolution tomography
##

proc ModulesHelp { } {
    puts stderr "scan_planner v2026.5.0 - Plan cylindrical scan regions in synchrotron tomography"
    puts stderr ""
    puts stderr "Usage:  scan_planner [config.json] [--debug]"
    puts stderr ""
    puts stderr "Source code is at /data/id16a/inhouse1/sware/Python/scan_plan (git-managed)."
    puts stderr "To update: cd /data/id16a/inhouse1/sware/Python/scan_plan && git pull"
}

module-whatis "scan_planner v2026.5.0 - Cylinder Packing GUI for ID16A tomography"

# Container image on CVMFS (read-only, only rebuilt when dependencies change)
set sif /cvmfs/hpc.esrf.fr/software/packages/linux/x86_64/scan_planner/2026.5.0/scan_planner.sif

# Source code on shared beamline storage (git-managed, updatable with git pull)
set src /data/id16a/inhouse1/sware/Python/scan_plan

# Wrapper: runs scan_planner inside the Apptainer container
# --writable-tmpfs: allows runtime fix for D-Bus machine-id
set-alias scan_planner "mkdir -p /tmp/run_user_\$(id -u) && apptainer exec --writable-tmpfs --bind ${src}:/opt/scan_plan,\$HOME:\$HOME,/tmp:/tmp,/tmp/run_user_\$(id -u):/run/user/\$(id -u) --env PYTHONPATH=/opt/scan_plan ${sif} bash -c 'cat /proc/sys/kernel/random/uuid | tr -d \"-\" > /etc/machine-id && mkdir -p /var/lib/dbus && cp /etc/machine-id /var/lib/dbus/machine-id && python -m scan_plan.cli \"\$@\"' _"
